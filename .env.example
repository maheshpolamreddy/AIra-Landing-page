# Copy to .env.local and fill in (already set for aira-landingpage)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Production site URL (no trailing slash) — used when syncing Firebase authorized domains
NEXT_PUBLIC_SITE_URL=https://aira-landing-page-elite.vercel.app

# One-time deploy fix: paste Firebase service account JSON (Project settings → Service accounts)
# Enables `pnpm auth:sync-domains` and automatic domain sync on Vercel postbuild.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Social sign-in providers shown on login/signup.
# Google works out of the box once enabled in Firebase.
# Apple requires Apple Developer Services ID + Team ID + Key in Firebase Console
# before setting NEXT_PUBLIC_AUTH_APPLE=true.
# Microsoft requires Azure app credentials in Firebase before enabling.
NEXT_PUBLIC_AUTH_GOOGLE=true
NEXT_PUBLIC_AUTH_APPLE=false
NEXT_PUBLIC_AUTH_MICROSOFT=false
