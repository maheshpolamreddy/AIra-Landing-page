# Curriculum content pipeline — set a strong random secret in production (required for admin/bridge API routes)
CONTENT_BRIDGE_SECRET=
# INNGEST_EVENT_KEY=  # Set in Vercel for production Inngest
# INNGEST_SIGNING_KEY=

# --- Local dev stack (ports) ---
# Landing HTTP          :3000
# Import worker         :3001  (CONTENT_IMPORT_WORKER_PORT)
# Pipeline worker       :3002  (CONTENT_PIPELINE_WORKER_PORT)
# Tutor Vite SPA        :5173
# Inngest dev server    :8288

# Tutor proxy — required for npm run start locally; auto-enabled in npm run dev
TUTOR_DEV_URL=http://127.0.0.1:5173

# Import worker dispatch (landing API → import worker)
# CONTENT_IMPORT_WORKER_RUN_URL=http://127.0.0.1:3001/run-import
