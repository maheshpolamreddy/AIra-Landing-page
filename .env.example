# Firebase Analytics DebugView on localhost (do not set in production)
# NEXT_PUBLIC_ANALYTICS_DEBUG=true

# GA4 Admin Product Analytics (Data API) — numeric property ID from GA4 Admin → Property settings
# Measurement ID G-9FT49STZ0P is client-only (NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID). Do not put G- here.
GA4_PROPERTY_ID=546252206
# Service account needs Analytics Viewer on GA4 property 546252206 (same JSON as FIREBASE_SERVICE_ACCOUNT_JSON)

# Curriculum content pipeline — set a strong random secret in production (required for admin/bridge API routes)
CONTENT_BRIDGE_SECRET=
# INNGEST_EVENT_KEY=  # Set in Vercel for production Inngest
# INNGEST_SIGNING_KEY=

# --- Local dev stack (ports) ---
# Landing HTTP          :3000
# Import worker         :3001  (CONTENT_IMPORT_WORKER_PORT)
# Pipeline worker       :3002  (CONTENT_PIPELINE_WORKER_PORT)
# Tutor Vite SPA        :5173
# Inngest dev server    :8288

# Tutor proxy — required for npm run start locally; auto-enabled in npm run dev
TUTOR_DEV_URL=http://127.0.0.1:5173

# Server-side AI (required for teaching/chat/studio via /api/ai/complete and competitive generate)
GROQ_API_KEY=
# GROQ_CHAT_MODEL=openai/gpt-oss-20b

# TTS (required for Listen / /api/tts)
SARVAM_API_KEY=
# Optional Rumik Silk TTS fallback (Indian voices) when Sarvam has no credits
RUMIK_API_KEY=
# ElevenLabs TTS (Settings ? ElevenLabs voices; model eleven_multilingual_v2)
ELEVENLABS_API_KEY=

# Import worker dispatch (landing API → import worker)
# CONTENT_IMPORT_WORKER_RUN_URL=http://127.0.0.1:3001/run-import
